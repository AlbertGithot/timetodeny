<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>TimeToDeny</AssemblyName>
    <RootNamespace>TimeToDeny.Launcher</RootNamespace>
    <ApplicationIcon>app_logo.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Company>Time To Deny</Company>
    <Product>Time To Deny Launcher</Product>
    <Description>Native Windows launcher for Time To Deny.</Description>
  </PropertyGroup>
</Project>
